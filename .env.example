# Trailwarden runtime settings
TRAILWARDEN_DEFAULT_BACKEND=not-configured
TRAILWARDEN_ANTHROPIC_MODEL=claude-sonnet-4-6
TRAILWARDEN_OLLAMA_MODEL=qwen2.5:14b

# External MCP servers are managed as separate processes.
TRAILWARDEN_AIRFLOW_MCP_URL=http://localhost:8091/mcp
TRAILWARDEN_DBT_MCP_URL=http://localhost:8092/mcp
TRAILWARDEN_TRINO_MCP_URL=http://localhost:8082/mcp
TRAILWARDEN_KUBERNETES_MCP_URL=http://localhost:8093/mcp
TRAILWARDEN_EMR_MCP_URL=http://localhost:8094/mcp

TRAILWARDEN_PROMPT_PATH=prompts/trailwarden-system.md
TRAILWARDEN_TRACE_DIR=.trailwarden/traces
TRAILWARDEN_MAX_DIAGNOSTIC_STEPS=12
